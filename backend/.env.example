JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=agrisense
DB_PASSWORD=
DB_NAME=agrisense_dev
DB_SSLMODE=disable

# ML service and private inspection images.
ML_SERVICE_URL=http://127.0.0.1:8000
INSPECTION_STORAGE_DIR=data/inspections
# Production: private Azure Blob container SAS URL, with read/create/delete permissions.
AZURE_BLOB_CONTAINER_SAS_URL=

# Local frontend origin, exact match without trailing slash. Comma-separated.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Local HTTP only. Production: true + HTTPS origins + GIN_MODE=release.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Empty = ignore forwarded IP headers. Set only actual reverse proxy IPs/CIDRs.
TRUSTED_PROXIES=
