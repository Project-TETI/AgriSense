JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# Local frontend origin, exact match without trailing slash. Comma-separated.
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Local HTTP only. Production: true + HTTPS origins + GIN_MODE=release.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Empty = ignore forwarded IP headers. Set only actual reverse proxy IPs/CIDRs.
TRUSTED_PROXIES=
